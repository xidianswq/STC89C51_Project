  97   2                      {
  98   3                              i=0;
  99   3                              //WIFI控制
 100   3                              if(UART_RX_BUF[VERIFY_NUM]==WATER_LEVEL_ON)
 101   3                                      setting_level=setting_level>WATER_DISTANCE_MIN?WATER_DISTANCE_MIN:setting_level+1;//设定水位加1                         
 102   3                              else if(UART_RX_BUF[VERIFY_NUM]==WATER_LEVEL_DOWN)
 103   3                                      setting_level=setting_level<WATER_DISTANCE_MAX?WATER_DISTANCE_MAX:setting_level-1;//设定水位减1
 104   3                      }
 105   2                      else if(UART_RX_BUF[0]=='@')i++;
