  12          
  13          //精确延时秒s
  14          void delay_s(u16 s)
  15          {
  16   1              void delay_ms(u16 ms);
  17   1              int temp=0;
  18   1              for(temp=0;temp<s;temp++)delay_ms(1000);                
  19   1      }
  20          
  21          //精确延时毫秒ms
  22          void delay_ms(u16 ms)
  23          {
  24   1              unsigned long int temp=system_tick;
  25   1              while(temp+ms>=system_tick);    
  26   1      }
  27          
  28          //定时器中断，系统节拍
